# data/raw/

# =========================
# Runtime logs
# =========================
logs/*.jsonl
logs/*.log

# =========================
# PRD one-command evaluation run outputs
# Each run creates reports/prd_runs/run_YYYYMMDD_HHMMSS/
# =========================
reports/prd_runs/*
!reports/prd_runs/.gitkeep

# =========================
# Temporary files
# =========================
*.tmp
*.temp
*.bak
*.swp